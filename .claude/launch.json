{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "station-docker",
      "url": "http://localhost:8080",
      "port": 8080
    },
    {
      "name": "app-dev",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "testpoint.api.app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--db",
        "sqlite:///data/dev.db",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "app-qa",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "testpoint.api.app",
        "--host",
        "127.0.0.1",
        "--port",
        "8002",
        "--db",
        "sqlite:///data/qa.db",
        "--reload"
      ],
      "port": 8002
    },
    {
      "name": "walk-app",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "testpoint.api.app",
        "--host",
        "127.0.0.1",
        "--port",
        "8003",
        "--db",
        "sqlite:///data/walk.db"
      ],
      "env": {
        "DISABLE_SQLALCHEMY_CEXT_RUNTIME": "1",
        "TESTPOINT_FACE_MODELS": "data/models/face"
      },
      "port": 8003
    },
    {
      "name": "deck-app",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "testpoint.api.app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--db",
        "sqlite:///data/deck.db",
        "--reload"
      ],
      "port": 8001
    },
    {
      "name": "prototype",
      "runtimeExecutable": "C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web/prototype"
      ],
      "port": 8765
    }
  ]
}