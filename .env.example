# Copy to .env and fill in. .env is git-ignored because it holds the camera password.

# Hikvision main stream. Password characters like @ : / must be URL-encoded.
CAMERA_URL=rtsp://admin:password@192.168.1.15:554/Streaming/Channels/101

# pushup or crunch
EXERCISE=pushup

# 1 = "Start TestPoint" also starts the rep-counting engine on CAMERA_URL
START_ENGINE=0

# Number of equal vertical lanes the camera watches
LANES=3

# lightweight, balanced or performance (performance must be in MODEL_MODES)
POSE_MODE=balanced

# Models baked into the image at build time
MODEL_MODES=lightweight balanced

# Host port for the station app (the original mock-up uses PROTOTYPE_PORT, default 8081)
APP_PORT=8080

# Time zone that decides which calendar day a test belongs to
TESTPOINT_TZ=Asia/Dubai

TESTPOINT_VERSION=0.1.0
